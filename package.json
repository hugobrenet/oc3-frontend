{
  "name": "oc3-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:ci": "vitest run",
    "format": "prettier --write .",
    "gen:api": "openapi-typescript \"${OC3_OPENAPI_URL:-http://127.0.0.1:8081/api/openapi.json}\" -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@ag-ui/core": "^1.0.4",
    "@fontsource-variable/ibm-plex-sans": "^5.1.0",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-router": "^1.120.0",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/react-virtual": "^3.13.0",
    "clsx": "^2.1.1",
    "i18next": "^25.0.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.7"
  }
}
